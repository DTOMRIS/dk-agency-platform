{
  "name": "dk-agency-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm install --include=dev && node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "start:local": "next start -H 127.0.0.1 -p 3001",
    "start:3000": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "hooks:install": "node scripts/install-hooks.mjs",
    "verify:protected": "node scripts/verify-protected.mjs",
    "verify:encoding": "node scripts/verify-encoding.mjs",
    "verify:staged": "node scripts/verify-protected.mjs --staged && node scripts/verify-encoding.mjs --staged",
    "verify": "node scripts/verify-protected-range-safe.mjs && npm run verify:encoding",
    "verify:task-range": "node scripts/verify-task-card.mjs --range",
    "snapshot:state": "node scripts/generate-state.mjs",
    "audit:drift": "node scripts/drift-audit.mjs",
    "audit:blogs": "tsx scripts/audit-blog-content.ts",
    "audit:system": "node scripts/generate-audit.mjs",
    "content:translate": "node --env-file=.env.local scripts/translate-content.mjs",
    "content:translate:dry": "node --env-file=.env.local scripts/translate-content.mjs --dry-run",
    "content:translate:mock": "node --env-file=.env.local scripts/translate-content.mjs --dry-run --mock --limit=1",
    "fetch:news": "node --env-file=.env.local scripts/fetch-news.mjs",
    "news:fetch": "tsx scripts/newsdata-fetch.ts",
    "news:synthesize": "tsx scripts/newsdata-synthesize.ts",
    "approve:news": "node scripts/approve-news.mjs",
    "db:seed": "npx tsx lib/db/seed.ts",
    "db:seed-blog": "npx tsx lib/db/seed-blog.ts",
    "dk:validate": "bash scripts/dk-validate.sh"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.34.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "typescript": "^5"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "@protobufjs/utf8": "1.1.1",
    "ws": "8.21.0",
    "lodash": "4.18.1",
    "dompurify": "3.4.11",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "js-yaml": "5.1.0",
    "sharp": "$sharp"
  }
}
